# Copy to .env.sam in the CVAT repository root and set the host directory.

# The directory must contain cvat.json with checkpoint (relative path) and type (vit_b/vit_l/vit_h).
SAM_WEIGHTS_DIR=/absolute/path/to/sam-weights

# Set to no for manual startup; always preserves the default restart behavior.
SAM_RESTART_POLICY=always
